# r24/r25: batched mount dir - only the Kconfig/源码 of the current batch
# are hooked into the 6.18 build (整棵 vendor Kconfig 会让 conf 静默失败, 见 r24 报告).
# r25: sources go through the $(KCONFIG_EXT_PREFIX) drivers/ symlink mirror so
# vendor sub-Kconfigs' internal $(KCONFIG_EXT_PREFIX) sources resolve too.

config DEVICE_MODULES_ALLOW_BUILTIN
	bool "allow builtin drivers into kernel image"
	default y
	help
	  All modules are default built as kernel modules.
	  Set DEVICE_MODULES_ALLOW_BUILTIN=y to build modules
	  into the kernel image.
	  If unsure, say N.

config RODIN_BLOB_DROP
	bool "skip loading policy-dropped 6.6 vendor blobs"
	default y
	help
	  Closed-source 6.6 blobs dropped by the A-55 recon decision: the
	  scheduler family (metis/mi_schedule, the b543 rq-recode consumers),
	  the millet and xiaomi net/memory MIUI-private endpoint families,
	  misc io/debug/info utilities, and two dead modules (migt has no
	  symbol providers since the sched =y batch, scheduler_ext is an
	  empty shell).  The stock load list still names them; the loader is
	  answered success and nothing is loaded.  mitee and the touch /
	  fpsgo-cus / bootmonitor blobs are NOT covered and keep loading.
	  If unsure, say Y.

# ---- r24 batch 1 ----
source "$(KCONFIG_EXT_PREFIX)drivers/clocksource/Kconfig"
