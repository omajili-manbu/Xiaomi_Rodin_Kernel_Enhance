# --- 批4-7 inline 门（杂项簇：lpm/swpm dbg/ssc/wla/atf/irtx/pwm + mtk_aov）---
# vendor 定义在未 source 的 {lpm,ssc,wla,irtx,pwm}/Kconfig 与 drivers/misc/mediatek/Kconfig；
# pwm/Kconfig redefines menuconfig PWM 不可整棵 source（4-5 先例），lpm/Kconfig 的
# MTK_LPM_MODULE_NAME 引用未定义 MTK_PLATFORM 字符串符号 ⇒ 一律 inline。
# 设备真值（devmod arch/arm64/configs/mgk_64_k66_defconfig）：这些门全 =m，翻 =y 即内建形态。
# 刻意不定义的（未定义 ≡ n，与设备一致）：
#   MTK_LPM_GS_DUMP_SUPPORT   设备 defconfig 显式 =n
#   MTK_CPU_IDLE_IPI_SUPPORT  default n；blob lpm-gov-MHSP.ko 无 update_ipi_history 符号实锤
#   MTK_LPM_MODULE_NAME       仅用于 =m 的 ko 命名（=y 走 Makefile 字面名 mtk-lpm.o）
config MTK_LOW_POWER_MODULE
	tristate "MediaTek Low Power Module (rodin inline)"
	help
	  mtk-lpm 家族总门（vendor def 在 lpm/Kconfig）。

config MTK_LPM_DBG_COMMON
	bool "MediaTek LPM common debug (rodin inline)"

config MTK_LPM_MT6899
	tristate "LPM platform MT6899 (rodin inline)"
	depends on MTK_LOW_POWER_MODULE
	select MTK_LPM_DBG_COMMON

