# ---- stage4 batch4-8: mali r49p1（kmod gpu/mt6899 叶子直挂）标准门 ----
# 为什么不 source midgard/Kconfig：它的 `source "$(MALI_KCONFIG_EXT_PREFIX)…/platform/tests"`
# 两行在前缀为空时会炸 kconfig，且其 depends/select 会牵动内核侧键（GPU_TRACEPTS 等本树无）。
# 这里按 4-8 实行指南内联 11 个门，取值来自 vendor defconfig + blob 符号实证（device truth）。
# 全部写成无 depends/select 的独立 bool —— 全树除 mali 源码外**零消费者**（已 grep 实证），
# 因此不会产生门翻连带；midgard 侧其余 ~50 个 CONFIG_MALI_MTK_* 旋钮由 gpu/mt6899/Makefile
# 的 export BUILD_RULE=OOT 阶梯 + Kbuild-mtk-custom-env 转 -D 供给，**刻意不进 kconfig**。
# ⚠️ 刻意**不定义** CONFIG_MALI_KUTF：设备 .config 无该键 ⇒ auto.conf 缺席 ⇒
#    midgard/Makefile:529 的 `ifneq ($(CONFIG_MALI_KUTF), n)` 为真 ⇒ MALI_KERNEL_TEST_API=1
#    （设备 blob 的 __ksymtab 有 186 项，正是此形态）；定义成 n 会与设备反向。

config MALI_MIDGARD
	bool "Mali Midgard kbase (rodin inline; LD2.0 对象名 mali_kbase_mt6899_r49)"
	default n

config MALI_CSF_SUPPORT
	bool "Mali CSF (Command Stream Frontend) support (rodin inline)"
	default n

config MALI_DEVFREQ
	bool "Mali devfreq support (rodin inline)"
	default n

config MALI_REAL_HW
	bool "Mali real hardware support (rodin inline)"
	default n

config MALI_DEBUG
	bool "Mali debug support (rodin inline)"
	default n

config MALI_FENCE_DEBUG
	bool "Mali fence debug (rodin inline)"
	default n

config LARGE_PAGE_SUPPORT
	bool "Mali large page support (rodin inline)"
	default n

config MALI_TRACE_POWER_GPU_WORK_PERIOD
	bool "Mali GPU work period trace (rodin inline)"
	default n

config MALI_BASE_MODULES
	bool "Mali base modules (rodin inline)"
	default n

config MALI_MEMORY_GROUP_MANAGER
	bool "Mali memory group manager (rodin inline; 对象名 mali_mgm_mt6899_r49)"
	default n

config MALI_PROTECTED_MEMORY_ALLOCATOR
	bool "Mali protected memory allocator (rodin inline; 对象名 mali_prot_alloc_mt6899_r49)"
	default n
# ---- stage4 batch4-9: perf/sched 栈（18 件纯源 =y 内建）----
# source 五棵 vendor Kconfig（经 rodin-ext/drivers/... 的符号链接镜像可达）：
#   * sched/Kconfig —— 本批**必须** source：它是 MAX_NR_CPUS 的**唯一**定义处
#     （`int "..." range 2 32 default "8"`；全树 grep 实证无第二处）。三个子代理
#     曾把它误判为"缺失符号 blocker"，实际只是当时没被 source。**不要**改成本树
#     CONFIG_NR_CPUS=32。同时提供 MTK_SCHEDULER / MTK_EAS / VIP / CORE_PAUSE / FLT /
#     GROUP_AWARE / OPP_CAP_INFO / NONLINEAR_FREQ_CTL / GEARLESS / SUGOV / CORE_CTL。
#   * 其余四棵是扁平 Kconfig（cache-auditor / perf_common / task_turbo /
#     cpufreq_lite），内部无子 source，可直接 source。
# mbraink/Kconfig **不可 source**：MTK_MBRAINK `select MTK_MBRAINK_BRIDGE` 而后者
# `depends on MTK_MBRAINK` ⇒ kconfig 依赖环。主体两门在下方 inline 定义。
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/sched/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/cache-auditor/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/perf_common/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/task_turbo/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/cpufreq_lite/Kconfig"

# --- rodin inline 门（vendor 无定义 / 定义位置不可 source）---
# 设备真值（mgk_64_k66_defconfig）：MTK_MBRAINK=m、MTK_MBRAINK_MT6899=m。
config MTK_MBRAINK
	tristate "MTK MBRAINK support (rodin inline: vendor def 在 mbraink/Kconfig，select 环不可 source)"
	help
	  mbraink/Makefile 的 obj-$(CONFIG_MTK_MBRAINK) 门控主体 13 个 .c 与 modules/。
	  （bridge/ 子目录是另一个门 MTK_MBRAINK_BRIDGE，见上。）

config MTK_MBRAINK_MT6899
	tristate "MTK MBRAINK for mt6899 (rodin inline)"
	depends on MTK_MBRAINK
	help
	  mbraink/modules/Makefile 与 modules/v6899/Makefile 的门控（后者同时按
	  CONFIG_MTK_SWPM_MODULE 多编 4 个 sys_res 文件，=m 写死门已改 filter y m）。

config MTK_HBT
	tristate "MTK HBT driver (rodin inline: vendor 两树均无 Kconfig 定义)"
	help
	  kmod hbt_driver/Kbuild 读此门（-DCONFIG_MTK_HBT 与 obj- 行）。设备 hbt.ko
	  真实发货，但门由 MTK Android 构建层注入、不在 vendor defconfig 里，故此处补定义。
	  注：同树 hbt_driver_cus/src/hbt.c 是 79 行残桩且被 Android.mk 反向守卫排除，
	  真身 = hbt_driver/src/hbt.c（507 行，md5 与 _cus 下同名文件逐字节相同）。


