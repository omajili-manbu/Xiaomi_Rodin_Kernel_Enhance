# r24/r25: batched mount dir - only the Kconfig/源码 of the current batch
# are hooked into the 6.18 build (整棵 vendor Kconfig 会让 conf 静默失败, 见 r24 报告).
# r25: sources go through the $(KCONFIG_EXT_PREFIX) drivers/ symlink mirror so
# vendor sub-Kconfigs' internal $(KCONFIG_EXT_PREFIX) sources resolve too.

config DEVICE_MODULES_ALLOW_BUILTIN
	bool "allow builtin drivers into kernel image"
	default y
	help
	  All modules are default built as kernel modules.
	  Set DEVICE_MODULES_ALLOW_BUILTIN=y to build modules
	  into the kernel image.
	  If unsure, say N.

# ---- r24 batch 1 ----
source "$(KCONFIG_EXT_PREFIX)drivers/clocksource/Kconfig"
# ---- r25 batch 2 (P0-core) ----
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/aee/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/monitor_hang/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/sda/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/log_store/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mtprintk/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/tinysys_scmi/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mminfra/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/vcp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mkp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/iommu/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/clk/mediatek/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/soc/mediatek/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/watchdog/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/nvmem/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/regulator/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/mailbox/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/interconnect/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/pinctrl/mediatek/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/char/hw_random/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/iommu/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/dma-buf/heaps/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/rpmsg/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/gpu/drm/mediatek/Kconfig"
# ---- stage2 batch 1 (P0 底座残余: smi/PMIC 族/存储底座/i2c/spmi/emi 簇/dcm) ----
source "$(KCONFIG_EXT_PREFIX)drivers/mfd/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/iio/adc/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/rtc/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/input/keyboard/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/mmc/host/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/phy/mediatek/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/i2c/busses/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/spmi/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/memory/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/dcm/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/smi/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/power/supply/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/usb/usb_boost/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/usb/usb_meta/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/usb/usb_xhci/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/usb/mtu3/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/tty/serial/8250/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/dma/mediatek/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/spi/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/typec/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/subpmic/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/dvfsrc/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/char/rpmb/Kconfig"

# ---- stage2 batch4 ----
source "$(KCONFIG_EXT_PREFIX)drivers/leds/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/cmdq/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mme/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mmp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/swpm/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/hw_sem/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/i3c_i2c_wrap/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/i3c/master/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mtk-interconnect/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mmdebug/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/pidmap/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/power_throttling/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/slbc/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/sspm/Kconfig"

# ---- stage3 S3b: vendor_boot misc batch (load_track/uload_ind/et/mdpm/pbm/masp/kshrink) ----
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/performance/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/et/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mdpm/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/pbm/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/masp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/xiaomi/kshrink_slabd/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/gate_ic/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/clkbuf/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/reset/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/tee/teeperf/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/devfreq/Kconfig"

config DEVICE_MODULES_PWM_MTK_DISP
	tristate "MediaTek display PWM driver (rodin inline: vendor pwm/Kconfig redefines menuconfig PWM)"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on HAS_IOMEM

config SND_SOC_MTK_SMART_PHONE
	tristate "Mediatek Smart Phone PCM Operation (rodin inline: vendor sound Kconfig has kernel-clashing SND_SOC_MT8188)"
	help
	  Mediatek PCM operation which is specific for smart phone product.

# ---- stage2 B2 ffa_v11 (vendor FFA v1.1 fork; kernel CONFIG_ARM_FFA_TRANSPORT
# must stay =n: kernel arm_ffa and this fork both define ffa_bus_type etc.) ----
config DEVICE_MODULES_ARM_FFA_TRANSPORT
	bool "vendor ffa_v11 (FF-A v1.1 fork) builtin gate (rodin inline)"
	help
	  Rodin-only gate for drivers/misc/mediatek/trusted_mem/ffa_v11 and the
	  tmem_ffa build family. Kept separate from the kernel's
	  CONFIG_ARM_FFA_TRANSPORT (=n) because both implementations export
	  ffa_bus_type/ffa_driver_register; enabling both breaks vmlinux link.

config DEVICE_MODULES_TMEM_FFA
	bool "vendor tmem_ffa (trusted_mem FFA variant) builtin (rodin inline)"
	depends on DEVICE_MODULES_ARM_FFA_TRANSPORT
	help
	  Builds the trusted_mem FFA-variant driver into the image. The device
	  blob lives in vendor_dlkm; flip to =y in the vendor_dlkm stage.

source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/trusted_mem/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/adsp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/blocktag/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/extcon/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/ufs/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/cpufreq/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/gpu/drm/panel/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mdp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/scp/Kconfig"



source "$(KCONFIG_EXT_PREFIX)drivers/pci/controller/Kconfig"
# ---- stage4 batch4-1(bootprof 新挂载 mtprof; thermal_generic_adc 内核树 B0 翻=y) ----
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mtprof/Kconfig"
# ---- stage4 batch4-2 (B2 点修 16+连带 iommu_engine; offload-common 顺延 4-5) ----
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/jpeg/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/vdec_fmt/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/widevine_drm/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/cm_mgr/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/geniezone/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/rps/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/media/platform/mtk-vcodec/Kconfig"

config DEVICE_MODULES_SND_SOC_MEDIATEK
	tristate "vendor snd-soc-mtk-common builtin gate (rodin inline: vendor sound Kconfig has kernel-clashing per-chip symbols)"
	help
	  Rodin-only gate for sound/soc/mediatek/common snd-soc-mtk-common.
	  The vendor definition lives in the unsourced sound/soc/mediatek/Kconfig
	  (promptless, selected by per-chip configs that clash with kernel ones).

config MTK_NET_CCMNI
	tristate "MediaTek CCMNI driver (rodin inline: vendor def depends MTK_CCCI_DEVICES which is not mounted)"
	help
	  Ladder key read directly by ccmni/Makefile (CCCI_CCMNI_OBJ). Defining
	  it inline drops the MTK_CCCI_DEVICES dependency; the ccci family lands
	  in batch 4-3 and may add its own definition later.

config DEVICE_MODULES_SND_SOC_AW882XX
	tristate "Awinic AW882XX Smart PA builtin gate (rodin inline: pa_combine Makefile was obj-m hardcode)"
	help
	  Rodin-only gate patching pa_combine/Makefile obj-m += snd-soc-aw882xx.o
	  into obj-$(CONFIG_DEVICE_MODULES_SND_SOC_AW882XX). MIEV telemetry
	  calls compile out with CONFIG_MIEV unset (miev blob stays closed).

config MTK_CCU_RPROC
	tristate "MediaTek CCU driver (rodin inline: vendor def depends RPMSG_MTK_CCD which lands in batch 4-4)"
	help
	  Gate read by kmod mtkcam/ccusys Kbuild. Vendor definition lives in the
	  unsourced devmod remoteproc/Kconfig behind RPMSG_MTK_CCD; defined here
	  without it so mtk_ccuv can be built-in ahead of the camera family.

config DEVICE_MODULES_VIDEO_MEDIATEK_VCODEC
	tristate "vendor mtk-vcodec builtin gate (rodin inline: vendor def lives in unsourced media/platform Kconfig)"
	depends on VIDEO_DEV
	help
	  Builds mtk-vcodec-common only (mtk-vcodec-dec/enc are fragments
	  consumed by V1/V2 platform blocks, both =n; dec-v2 lands in batch
	  4-3/4-7 behind CONFIG_VIDEO_MEDIATEK_VCODEC_V2).

# ---- stage4 batch4-3 (GPU/perf/thermal/振动器/pmsr/sapu/met/mae/dec-v2) ----
# 源门（vendor Kconfig 直接 source；其内部嵌套 source 由 rodin-ext symlink 镜像解析）
source "$(KCONFIG_EXT_PREFIX)drivers/input/misc/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/gpu/mediatek/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/cg_ppt/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/qos/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/pgboost/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/pmsr/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/thermal/mediatek/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/apusys/Kconfig"

# --- rodin inline 门（vendor 定义位置不可直接 source 的）---

config MTK_SENSOR_SUPPORT
	tristate "MediaTek sensor framework gate (rodin inline: sensor/Kconfig sources 1.0/2.0 全族，2.0/Kconfig 又 source nanohub/sensorhub/test/lsm6dsm 四个未挂子树)"
	help
	  hf_manager 的门（sensor/2.0/core/Makefile）。父 sensor/2.0/Makefile 的
	  `obj-y += core/` 是无条件行，其余子目录各有自己的门且保持未定义(=n)。

config DEVICE_MODULES_VIDEO_MEDIATEK_JPEG
	tristate "vendor mtk-jpeg builtin gate (rodin inline: vendor def 在未 source 的 media/platform/Kconfig，带 4 条内核侧 depends)"
	help
	  mtk-jpeg 的门。vendor 定义 depends on MTK_IOMMU_V1||DEVICE_MODULES_MTK_IOMMU、
	  VIDEO_DEV、ARCH_MEDIATEK、DEVICE_MODULES_MTK_SMI 并 select
	  VIDEOBUF2_DMA_CONTIG/V4L2_MEM2MEM_DEV——前者本树已 =y、select 目标内核侧已 =y，
	  故内联定义（同 4-2 的 VIDEO_MEDIATEK_VCODEC 手法）。

config MTK_CAMERA_MAE_SUPPORT
	tristate "MediaTek MAE (rodin inline: vendor def 在 kmod mtkcam/mtk-mae/Kconfig)"
	select V4L2_MEM2MEM_DEV
	help
	  kmod mtk-mae Kbuild 读此门，同门编 mtk_mae + mtk_mae_isp8 两件
	  （两者都有设备 blob，必须同批同跳）。

config MTK_MET
	tristate "MET profile (rodin inline: vendor def 在 devmod drivers/misc/mediatek/Kconfig 顶层，source 整棵有 conf 静默失败前科)"
	help
	  kmod met_drv_v3/common/Kbuild 读此门。设备 met.ko 实测来自 met_drv_v3
	  （blob strings 证据：../vendor/mediatek/kernel_modules/met_drv_v3/common/...）。

config VIDEO_MEDIATEK_VCODEC_ENC_V2
	bool "Video Vcodec ENC V2 (rodin 拆分: vendor 把 dec/enc v2 写在同一个 ifeq 块)"
	help
	  vendor mtk-vcodec/Makefile 的 V2 块同时编 mtk-vcodec-dec-v2.o 与
	  mtk-vcodec-enc-v2.o。enc-v2 的符号闭包压在 perf/sched 簇（含闭源
	  metis/mi_schedule），本批只能收 dec-v2；拆分门默认 n，enc-v2 顺延。

config MTK_POWERHAL_CPU_CTRL
	tristate "vendor powerhal_cpu_ctrl (rodin 拆分: vendor 用 MTK_PERFORMANCE_MODULE 一门编 5 件)"
	help
	  performance/Makefile 原以 MTK_PERFORMANCE_MODULE 同时编
	  mtk_perf_ioctl/mtk_ioctl_touch_boost/mtk_ioctl_powerhal/touch_boost/ 与
	  powerhal_cpu_ctrl/。后者闭包含闭源 metis/mi_schedule ⇒ 拆出独立门默认 n。

# ---- stage4 batch4-4 (相机族 9 + 传感器/vcm/标定 4 + 辅助 4 + 拉入提供者 mbraink_bridge = 19 件) ----
# source：devmod media/platform/mtk-isp/Kconfig 是扁平文件（18 个 config，无子 source），
# 经已有 rodin-ext/drivers/media 符号链接可达；提供 VIDEO_MTK_ISP_* 全部相机门。
source "$(KCONFIG_EXT_PREFIX)drivers/media/platform/mtk-isp/Kconfig"

# --- rodin inline 门（vendor 定义位置不可直接 source：带子 source / 与内核同名面重叠 /
#     定义在未挂载树）---

config MTK_CAMERA_ISP_SUPPORT
	tristate "Camera ISP Driver Support (rodin inline: vendor cameraisp/Kconfig 带 9 个子 source)"
	help
	  dpe 家族的父门。设备真值 =m。本批只由 camera_dpe_isp8 消费。

config MTK_CAMERA_ISP_PDA_SUPPORT
	tristate "[PDA] Phase Distortion point Accelerator (rodin inline: vendor cameraisp/pda/Kconfig)"
	help
	  pda_drv_mt6899 的门。设备真值 =m。

config MTK_V4L2_IMGSENSOR
	tristate "MediaTek v4l2 image sensor support (rodin inline: vendor imgsensor/Kconfig 带子 source)"
	select VIDEO_V4L2_SUBDEV_API
	select MEDIA_CONTROLLER
	select V4L2_FWNODE
	select I2C
	help
	  imgsensor_isp8 + imgsensor-glue_isp8 的门（src-isp8/Kbuild）。设备真值 =m。

config MTK_V4L2_LENS
	tristate "Mediatek V4L2 lens driver (rodin inline: vendor lens/Kconfig 全族未挂载)"
	help
	  camera_af_media 的门（lens/vcm/v4l2/media/Makefile）。设备真值 =m。

config MTK_V4L2_CAM_CAL
	tristate "MTK camera cal driver (rodin inline: vendor devmod cam_cal/Kconfig；构建入口在 kmod)"
	help
	  camera_eeprom_v4l2 的门（kmod mtkcam/cam_cal 的 obj-m 硬编补丁后读它）。设备真值 =m。

config MTK_IPS_HELPER
	tristate "MTK IPS Helper debugging Support (rodin inline: vendor ips/Kconfig)"
	help
	  mtk-ips-helper 的门。设备真值 =m。

config MI_CAMLOG
	tristate "Camera Camlog Driver Support (rodin inline: vendor cam_log/Kconfig; Makefile obj-m 硬编)"
	help
	  cam_log 的门。设备真值 =m。

config MTK_CCD_REMOTEPROC
	tristate "MediaTek CCD driver (rodin inline: vendor def 在 devmod remoteproc/Kconfig 的 if REMOTEPROC 内)"
	help
	  mtk_ccd_remoteproc 的门。设备真值 =m。不 source 该文件是为了避免
	  与内核树自身 drivers/remoteproc/Kconfig 的 menu 双定义。

config MTK_CAMERA_DPE_ISP8
	tristate "[DPE] Depth Engine ISP8 (rodin inline: 定义在 kmod mtkcam/mtk-dpe/Kconfig)"
	depends on MTK_CAMERA_ISP_SUPPORT
	help
	  camera_dpe_isp8 的门。同目录 7SP/7S 门保持未定义。

config MTK_MBRAINK_BRIDGE
	tristate "MTK MBRAINK BRIDGE support (rodin inline: vendor def depends MTK_MBRAINK=主体属 4-5)"
	help
	  mtk_mbraink_bridge 的门（devmod mbraink/bridge）。去 depends 的依据＝设备 blob
	  闭包实测对 mbraink 主体零引用（仅注册 ops 面），可独立编。本批拉入它是因为
	  imgsys/cmdq 的 imgsys2mbrain_notify_hw_time_info 唯一提供者就是它。

config BUILD_XIAOMI_CAMERA_IMAGE_NAMES
	string "Xiaomi camera image name (rodin inline: 设备真值在 devmod kernel/configs/rodin.config)"
	default "rodin"
	help
	  cam_cal custom/Kbuild 的 ifeq 读它决定 -DRODIN_CAM。设备真值 ="rodin"，
	  vendor 树里无 Kconfig 定义（只由 config fragment 注入），故此处补上。

# ---- stage4 batch4-3b (eccci 族) ----
# eccci/Kconfig = MTK_ECCI_DRIVER(tristate, depends MTK_CCCI_DEVICES, select
#   MTK_NET_CCMNI/PAGE_POOL) + MTK_ECCI_CLDMA/CCIF/C2K/C2K_USB + DEBUG_LOG；
# ccci_util/Kconfig = menuconfig MTK_CCCI_DEVICES + MTK_MD1_SUPPORT(int)。
# 两份都是扁平文件（无子 source）。MTK_NET_CCMNI 仍用上面的 rodin inline 定义
# （ccmni/Kconfig 未 source；eccci/Kconfig 仅 select 它）。
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/eccci/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/ccci_util/Kconfig"

config MTK_AUDIO_IPI
	tristate "MTK audio ipi support (rodin inline: vendor def depends MTK_AUDIODSP_SUPPORT||MTK_SCP_AUDIO)"
	help
	  批 4-3b 拉入的门。vendor 定义在 audio_ipi/Kconfig（未 source，避免与
	  其内的 DEVICE_MODULES_VHOST_ADSP/ADSP_VOIP_LEGACY 一并引入）。依赖去掉的
	  依据＝实测：audio_ipi.ko 的 61 个 UND 相对 4-4 基线 0 缺失（链接期自足），
	  adsp/include 等 -I 在 vendor Makefile 里本就是无条件行。
