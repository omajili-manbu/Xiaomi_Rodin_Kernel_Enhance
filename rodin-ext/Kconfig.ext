# ---- stage3 S3b: vendor_boot misc batch (load_track/uload_ind/et/mdpm/pbm/masp/kshrink) ----
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/performance/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/et/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mdpm/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/pbm/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/masp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/xiaomi/kshrink_slabd/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/gate_ic/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/clkbuf/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/reset/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/tee/teeperf/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/devfreq/Kconfig"

config DEVICE_MODULES_PWM_MTK_DISP
	tristate "MediaTek display PWM driver (rodin inline: vendor pwm/Kconfig redefines menuconfig PWM)"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	depends on HAS_IOMEM

config SND_SOC_MTK_SMART_PHONE
	tristate "Mediatek Smart Phone PCM Operation (rodin inline: vendor sound Kconfig has kernel-clashing SND_SOC_MT8188)"
	help
	  Mediatek PCM operation which is specific for smart phone product.

# ---- stage2 B2 ffa_v11 (vendor FFA v1.1 fork; kernel CONFIG_ARM_FFA_TRANSPORT
# must stay =n: kernel arm_ffa and this fork both define ffa_bus_type etc.) ----
config DEVICE_MODULES_ARM_FFA_TRANSPORT
	bool "vendor ffa_v11 (FF-A v1.1 fork) builtin gate (rodin inline)"
	help
	  Rodin-only gate for drivers/misc/mediatek/trusted_mem/ffa_v11 and the
	  tmem_ffa build family. Kept separate from the kernel's
	  CONFIG_ARM_FFA_TRANSPORT (=n) because both implementations export
	  ffa_bus_type/ffa_driver_register; enabling both breaks vmlinux link.

config DEVICE_MODULES_TMEM_FFA
	bool "vendor tmem_ffa (trusted_mem FFA variant) builtin (rodin inline)"
	depends on DEVICE_MODULES_ARM_FFA_TRANSPORT
	help
	  Builds the trusted_mem FFA-variant driver into the image. The device
	  blob lives in vendor_dlkm; flip to =y in the vendor_dlkm stage.

source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/trusted_mem/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/adsp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/blocktag/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/extcon/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/ufs/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/cpufreq/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/gpu/drm/panel/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/mdp/Kconfig"
source "$(KCONFIG_EXT_PREFIX)drivers/misc/mediatek/scp/Kconfig"



source "$(KCONFIG_EXT_PREFIX)drivers/pci/controller/Kconfig"
