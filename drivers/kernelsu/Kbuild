# Bridge: the inline syscall-hook architecture (lsm_hook, tp_marker,
# syscall_event_bridge, syscall_hook_manager, per-arch syscall_hook and
# non-arm64 patch_memory) is not compiled; hook_stub.o provides no-op
# entry points so upstream call sites stay untouched. arm64 patch_memory
# stays compiled: mount_hide patches file_operations pointers with it.
kernelsu-objs += hook/hook_stub.o
